# Copy to .env.local and fill in values (never commit .env.local).

# Spreadsheet ID from the URL (between /d/ and /edit), e.g.:
# https://docs.google.com/spreadsheets/d/1OslAdcsd1c4wc_6zW4argGul2PF1N2xpydqCOLTIDfs/edit
GOOGLE_SHEET_ID=

# Range: header row + columns through F (area, address, number, code type, code, note).
# If your tab is not named "גיליון1", use Sheet1!A:F or your exact tab name:
GOOGLE_SHEET_RANGE=גיליון1!A:F

# Full service account JSON as a single line. On Vercel, paste the file contents.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Server cache TTL in milliseconds (default 180000 = 3 minutes)
# CODES_CACHE_TTL_MS=180000

# Production site URL (e.g. on Vercel): used for Open Graph and absolute metadata. Optional.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# WhatsApp for building-entry code submissions (digits only — E.164 without +).
# Example (not a real number): 972501234567
NEXT_PUBLIC_WHATSAPP_E164=

# Authentication
ADMIN_PASSWORD=
ADD_CODE_PASSWORD=
ADD_AUTHORIZED_PASSWORD=
AUTH_ALLOWLIST_DEV_EMAIL=
GOOGLE_SHEET_AUTH_RANGE=מורשים!A:B

